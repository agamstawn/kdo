<section class="page-heading"><div><h1>Pegawai Negeri Sipil</h1><p>Catat pegawai yang bertanggung jawab atas kendaraan.</p></div><%= link_to "+ Tambah pegawai", new_pegawai_path, class: "button" %></section>
<section class="panel"><div class="panel-header"><h2>Daftar pegawai</h2><input class="search" data-table-search="#employees" placeholder="Cari nama, NIP, jabatan"></div><table id="employees"><thead><tr><th>Nama / NIP</th><th>Jabatan</th><th>Golongan</th><th>Perangkat daerah</th><th></th></tr></thead><tbody><% @pegawais.each do |pegawai| %><tr><td><%= link_to pegawai.nama, pegawai, class: "link" %><br><small><%= pegawai.nip %></small></td><td><%= pegawai.jabatan %></td><td><%= pegawai.golongan %></td><td><%= pegawai.perangkat_daerah.nama %></td><td class="actions"><%= link_to "Ubah", edit_pegawai_path(pegawai), class: "link" %><%= button_to "Hapus", pegawai, method: :delete, class: "button button--danger", form: { data: { turbo_confirm: "Hapus pegawai ini?" } } %></td></tr><% end %><% if @pegawais.empty? %><tr><td colspan="5" class="empty">Belum ada data pegawai.</td></tr><% end %></tbody></table></section>
