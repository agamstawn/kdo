<section class="page-heading"><div><h1>Pegawai Negeri Sipil</h1><p>Catat pegawai yang bertanggung jawab atas kendaraan.</p></div><%= link_to "+ Tambah pegawai", new_pegawai_path, class: "button" %></section>
<section class="panel"><%= form_with url: pegawais_path, method: :get, class: "filter-form" do |form| %><%= form.text_field :q, value: params[:q], placeholder: "Nama, NIP, atau jabatan" %><%= form.collection_select :perangkat_daerah_id, PerangkatDaerah.order(:nama), :id, :nama, { include_blank: "Semua perangkat daerah", selected: params[:perangkat_daerah_id] } %><%= form.submit "Terapkan", class: "button" %><%= link_to "Reset", pegawais_path, class: "button button--secondary" %><% end %><div class="panel-header"><h2>Daftar pegawai</h2></div><table><thead><tr><th>Nama / NIP</th><th>Jabatan</th><th>Golongan</th><th>Perangkat daerah</th><th>Aksi</th></tr></thead><tbody><% @pegawais.each do |pegawai| %><tr><td><%= link_to pegawai.nama, pegawai, class: "link" %><br><small><%= pegawai.nip %></small></td><td><%= pegawai.jabatan %></td><td><%= pegawai.golongan %></td><td><%= pegawai.perangkat_daerah.nama %></td><td class="actions"><%= link_to "Detail", pegawai, class: "link" %><%= link_to "Ubah", edit_pegawai_path(pegawai), class: "link" %><%= button_to "Hapus", pegawai, method: :delete, class: "button button--danger", form: { data: { turbo_confirm: "Hapus pegawai ini?" } } %></td></tr><% end %><% if @pegawais.empty? %><tr><td colspan="5" class="empty">Tidak ada pegawai yang cocok.</td></tr><% end %></tbody></table><%= render "shared/pagination", pagination: @pagination %></section>
