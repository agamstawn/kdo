<%= form_with model: kendaraan_dinas, url: kendaraan_dinas.persisted? ? show_kendaraan_path(kendaraan_dinas) : kendaraan_dinas_index_path, class: "form-card", data: { vehicle_form: true } do |form| %>
  <% if kendaraan_dinas.errors.any? %><div class="error-box"><%= kendaraan_dinas.errors.full_messages.to_sentence %></div><% end %>
  <div class="form-grid"><div class="field"><%= form.label :nomor_polisi, "Nomor polisi" %><%= form.text_field :nomor_polisi, autofocus: true, placeholder: "Contoh: B 1234 KDO" %></div><div class="field"><%= form.label :merek %><%= form.text_field :merek, placeholder: "Contoh: Toyota" %></div><div class="field"><%= form.label :model, "Tipe / model" %><%= form.text_field :model, placeholder: "Contoh: Innova" %></div><div class="field"><%= form.label :tahun_produksi %><%= form.number_field :tahun_produksi, min: 1900, max: Date.current.year + 1 %></div><div class="field"><%= form.label :warna %><%= form.text_field :warna %></div><div class="field"><%= form.label :status, "Kondisi / status" %><%= form.select :status, KendaraanDinas.statuses.keys.map { |status| [status.titleize, status] }, prompt: "Pilih status" %></div><div class="field"><%= form.label :perangkat_daerah_id, "Perangkat daerah" %><%= form.collection_select :perangkat_daerah_id, PerangkatDaerah.order(:nama), :id, :nama, { prompt: "Pilih perangkat daerah" }, data: { perangkat_daerah_select: true } %><p class="form-help">Pilih perangkat daerah terlebih dahulu.</p></div><div class="field"><%= form.label :penanggung_jawab_id, "Pegawai penanggung jawab" %><%= form.select :penanggung_jawab_id, options_for_select(Pegawai.includes(:perangkat_daerah).order(:nama).map { |pegawai| ["#{pegawai.nama} — #{pegawai.perangkat_daerah.nama}", pegawai.id, { data: { perangkat_daerah_id: pegawai.perangkat_daerah_id } }] }, kendaraan_dinas.penanggung_jawab_id), { prompt: "Pilih pegawai" }, data: { penanggung_jawab_select: true } %><p class="form-help">Daftar pegawai disaring sesuai perangkat daerah.</p></div></div>
  <div class="form-actions"><%= form.submit "Simpan", class: "button" %><%= link_to "Batal", kendaraan_dinas_index_path, class: "button button--secondary" %></div>
<% end %>
