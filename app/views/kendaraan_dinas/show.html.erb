<section class="page-heading"><div><h1><%= @kendaraan_dinas.nomor_polisi %></h1><p><%= @kendaraan_dinas.merek %> <%= @kendaraan_dinas.model %></p></div><div class="detail-actions"><%= link_to "Kembali ke kendaraan", kendaraan_dinas_index_path, class: "button button--secondary" %><%= link_to "+ Catat perawatan", new_riwayat_perawatan_path(kendaraan_dinas_id: @kendaraan_dinas.id), class: "button" %><%= link_to "Ubah", edit_kendaraan_dinas_path(@kendaraan_dinas), class: "button button--secondary" %></div></section>
<section class="form-card"><dl class="details"><div><dt>Merek</dt><dd><%= @kendaraan_dinas.merek %></dd></div><div><dt>Tipe / model</dt><dd><%= @kendaraan_dinas.model %></dd></div><div><dt>Tahun produksi</dt><dd><%= @kendaraan_dinas.tahun_produksi %></dd></div><div><dt>Warna</dt><dd><%= @kendaraan_dinas.warna %></dd></div><div><dt>Status</dt><dd><span class="badge badge--<%= @kendaraan_dinas.status %>"><%= @kendaraan_dinas.status.titleize %></span></dd></div><div><dt>Perangkat daerah</dt><dd><%= @kendaraan_dinas.perangkat_daerah.nama %></dd></div><div><dt>Penanggung jawab</dt><dd><%= @kendaraan_dinas.penanggung_jawab.nama %></dd></div><div><dt>Total biaya perawatan</dt><dd><%= number_to_currency @total_biaya_perawatan || 0, unit: "Rp", precision: 0, delimiter: "." %></dd></div></dl></section>
<section class="panel" style="margin-top:24px"><div class="panel-header"><h2>Riwayat Perawatan</h2><span><%= @riwayat_perawatans.count %> catatan</span></div><table><thead><tr><th>Tanggal</th><th>Jenis</th><th>Keterangan</th><th>Biaya</th></tr></thead><tbody><% @riwayat_perawatans.each do |riwayat| %><tr><td><%= riwayat.tanggal.strftime("%d-%m-%Y") %></td><td><%= riwayat.jenis %></td><td><%= riwayat.keterangan %></td><td><%= number_to_currency riwayat.biaya || 0, unit: "Rp", precision: 0, delimiter: "." %></td></tr><% end %><% if @riwayat_perawatans.empty? %><tr><td colspan="4" class="empty">Belum ada perawatan yang dicatat.</td></tr><% end %></tbody></table></section>
