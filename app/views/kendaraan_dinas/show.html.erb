<section class="page-heading"><div><h1><%= @kendaraan_dinas.nomor_polisi %></h1><p><%= @kendaraan_dinas.merek %> <%= @kendaraan_dinas.model %></p></div><%= link_to "Ubah", edit_kendaraan_dinas_path(@kendaraan_dinas), class: "button" %></section><section class="form-card"><dl class="details"><div><dt>Merek</dt><dd><%= @kendaraan_dinas.merek %></dd></div><div><dt>Tipe / model</dt><dd><%= @kendaraan_dinas.model %></dd></div><div><dt>Tahun produksi</dt><dd><%= @kendaraan_dinas.tahun_produksi %></dd></div><div><dt>Warna</dt><dd><%= @kendaraan_dinas.warna %></dd></div><div><dt>Status</dt><dd><span class="badge badge--<%= @kendaraan_dinas.status %>"><%= @kendaraan_dinas.status.humanize %></span></dd></div><div><dt>Perangkat daerah</dt><dd><%= @kendaraan_dinas.perangkat_daerah.nama %></dd></div><div><dt>Penanggung jawab</dt><dd><%= @kendaraan_dinas.penanggung_jawab.nama %></dd></div></dl></section>
