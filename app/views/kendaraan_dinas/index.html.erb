<section class="page-heading"><div><h1>Kendaraan Dinas</h1><p>Pantau kondisi dan penanggung jawab aset operasional.</p></div><%= link_to "+ Tambah kendaraan", new_kendaraan_dinas_path, class: "button" %></section>
<section class="panel"><%= form_with url: kendaraan_dinas_index_path, method: :get, class: "filter-form" do |form| %><%= form.text_field :q, value: params[:q], placeholder: "Nomor polisi, merek, atau model" %><%= form.select :status, KendaraanDinas.statuses.keys.map { |status| [status.titleize, status] }, { include_blank: "Semua status", selected: params[:status] } %><%= form.collection_select :perangkat_daerah_id, PerangkatDaerah.order(:nama), :id, :nama, { include_blank: "Semua perangkat daerah", selected: params[:perangkat_daerah_id] } %><%= form.submit "Terapkan", class: "button" %><%= link_to "Reset", kendaraan_dinas_index_path, class: "button button--secondary" %><% end %><div class="panel-header"><h2>Daftar kendaraan</h2><input class="search" data-table-search="#vehicles" placeholder="Saring halaman ini"></div><table id="vehicles"><thead><tr><th>Nomor polisi</th><th>Kendaraan</th><th>Tahun</th><th>Perangkat daerah</th><th>Penanggung jawab</th><th>Status</th><th></th></tr></thead><tbody><% @kendaraan_dinas.each do |kendaraan| %><tr><td><%= link_to kendaraan.nomor_polisi, show_kendaraan_path(kendaraan), class: "link" %></td><td><%= kendaraan.merek %> <%= kendaraan.model %><br><small><%= kendaraan.warna %></small></td><td><%= kendaraan.tahun_produksi %></td><td><%= kendaraan.perangkat_daerah.nama %></td><td><%= kendaraan.penanggung_jawab.nama %></td><td><span class="badge badge--<%= kendaraan.status %>"><%= kendaraan.status.titleize %></span></td><td class="actions"><%= link_to "Ubah", edit_kendaraan_dinas_path(kendaraan), class: "link" %><%= button_to "Hapus", show_kendaraan_path(kendaraan), method: :delete, class: "button button--danger", form: { data: { turbo_confirm: "Hapus kendaraan ini?" } } %></td></tr><% end %><% if @kendaraan_dinas.empty? %><tr><td colspan="7" class="empty">Tidak ada kendaraan yang cocok.</td></tr><% end %></tbody></table><%= render "shared/pagination", pagination: @pagination %></section>
