<section class="page-heading"><div><h1>Perangkat Daerah</h1><p>Kelola unit kerja pemilik kendaraan dan pegawai.</p></div><%= link_to "+ Tambah perangkat daerah", new_perangkat_daerah_path, class: "button" %></section>
<section class="panel"><%= form_with url: perangkat_daerahs_path, method: :get, class: "filter-form" do |form| %><%= form.text_field :q, value: params[:q], placeholder: "Cari perangkat daerah" %><%= form.submit "Cari", class: "button" %><%= link_to "Reset", perangkat_daerahs_path, class: "button button--secondary" %><% end %><div class="panel-header"><h2>Daftar perangkat daerah</h2></div><table><thead><tr><th>Nama</th><th>Pegawai</th><th>Kendaraan</th><th>Aksi</th></tr></thead><tbody><% @perangkat_daerahs.each do |unit| %><tr><td><%= link_to unit.nama, unit, class: "link" %></td><td><%= unit.pegawais.count %></td><td><%= unit.kendaraan_dinas.count %></td><td class="actions"><%= link_to "Detail", unit, class: "link" %><%= link_to "Ubah", edit_perangkat_daerah_path(unit), class: "link" %><%= button_to "Hapus", unit, method: :delete, class: "button button--danger", form: { data: { turbo_confirm: "Hapus perangkat daerah ini?" } } %></td></tr><% end %><% if @perangkat_daerahs.empty? %><tr><td colspan="4" class="empty">Tidak ada perangkat daerah yang cocok.</td></tr><% end %></tbody></table><%= render "shared/pagination", pagination: @pagination %></section>
