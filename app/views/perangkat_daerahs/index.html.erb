<section class="page-heading"><div><h1>Perangkat Daerah</h1><p>Kelola unit kerja pemilik kendaraan dan pegawai.</p></div><%= link_to "+ Tambah perangkat daerah", new_perangkat_daerah_path, class: "button" %></section>
<section class="panel"><div class="panel-header"><h2>Daftar perangkat daerah</h2><input class="search" data-table-search="#agencies" placeholder="Cari perangkat daerah"></div><table id="agencies"><thead><tr><th>Nama</th><th>Pegawai</th><th>Kendaraan</th><th></th></tr></thead><tbody><% @perangkat_daerahs.each do |unit| %><tr><td><%= link_to unit.nama, unit, class: "link" %></td><td><%= unit.pegawais.count %></td><td><%= unit.kendaraan_dinas.count %></td><td class="actions"><%= link_to "Ubah", edit_perangkat_daerah_path(unit), class: "link" %><%= button_to "Hapus", unit, method: :delete, class: "button button--danger", form: { data: { turbo_confirm: "Hapus perangkat daerah ini?" } } %></td></tr><% end %><% if @perangkat_daerahs.empty? %><tr><td colspan="4" class="empty">Belum ada perangkat daerah.</td></tr><% end %></tbody></table></section>
