<%= form_with model: perangkat_daerah, class: "form-card" do |form| %>
  <% if perangkat_daerah.errors.any? %><div class="error-box"><%= perangkat_daerah.errors.full_messages.to_sentence %></div><% end %>
  <div class="field"><%= form.label :nama, "Nama perangkat daerah" %><%= form.text_field :nama, autofocus: true, placeholder: "Contoh: Dinas Pendidikan" %></div>
  <div class="form-actions"><%= form.submit "Simpan", class: "button" %><%= link_to "Batal", perangkat_daerahs_path, class: "button button--secondary" %></div>
<% end %>
