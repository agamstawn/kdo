<%= form_with model: riwayat_perawatan, class: "form-card" do |form| %>
  <% if riwayat_perawatan.errors.any? %><div class="error-box"><%= riwayat_perawatan.errors.full_messages.to_sentence %></div><% end %>
  <div class="form-grid"><div class="field field--wide"><%= form.label :kendaraan_dinas_id, "Kendaraan dinas" %><%= form.collection_select :kendaraan_dinas_id, KendaraanDinas.order(:nomor_polisi), :id, :nomor_polisi, { prompt: "Pilih kendaraan" } %></div><div class="field"><%= form.label :tanggal %><%= form.date_field :tanggal %></div><div class="field"><%= form.label :jenis, "Jenis perawatan" %><%= form.text_field :jenis, placeholder: "Contoh: Servis berkala" %></div><div class="field field--wide"><%= form.label :keterangan %><%= form.text_area :keterangan, rows: 4, placeholder: "Uraikan pekerjaan perawatan" %></div><div class="field"><%= form.label :biaya, "Biaya (Rp)" %><%= form.number_field :biaya, min: 0, step: 1000 %></div></div>
  <div class="form-actions"><%= form.submit "Simpan", class: "button" %><%= link_to "Batal", riwayat_perawatans_path, class: "button button--secondary" %></div>
<% end %>
