<section class="page-heading"><div><h1><%= @riwayat_perawatan.jenis %></h1><p><%= @riwayat_perawatan.kendaraan_dinas.nomor_polisi %> · <%= l @riwayat_perawatan.tanggal, format: :long %></p></div><div class="detail-actions"><%= link_to "Kembali ke perawatan", riwayat_perawatans_path, class: "button button--secondary" %><%= link_to "Ubah", edit_riwayat_perawatan_path(@riwayat_perawatan), class: "button" %></div></section><section class="form-card"><dl class="details"><div><dt>Kendaraan</dt><dd><%= @riwayat_perawatan.kendaraan_dinas.nomor_polisi %></dd></div><div><dt>Biaya</dt><dd><%= number_to_currency @riwayat_perawatan.biaya || 0, unit: "Rp", precision: 0, delimiter: "." %></dd></div><div class="field--wide"><dt>Keterangan</dt><dd><%= @riwayat_perawatan.keterangan %></dd></div></dl></section>
