<section class="page-heading"><div><h1>Riwayat Perawatan</h1><p>Catatan pemeriksaan dan perbaikan kendaraan operasional.</p></div><%= link_to "+ Catat perawatan", new_riwayat_perawatan_path, class: "button" %></section>
<section class="panel"><%= form_with url: riwayat_perawatans_path, method: :get, class: "filter-form" do |form| %><%= form.text_field :q, value: params[:q], placeholder: "Jenis atau uraian perawatan" %><%= form.collection_select :kendaraan_dinas_id, KendaraanDinas.order(:nomor_polisi), :id, :nomor_polisi, { include_blank: "Semua kendaraan", selected: params[:kendaraan_dinas_id] } %><%= form.submit "Terapkan", class: "button" %><%= link_to "Reset", riwayat_perawatans_path, class: "button button--secondary" %><% end %><div class="panel-header"><h2>Riwayat terbaru</h2></div><table><thead><tr><th>Tanggal</th><th>Kendaraan</th><th>Jenis</th><th>Biaya</th><th></th></tr></thead><tbody><% @riwayat_perawatans.each do |riwayat| %><tr><td><%= riwayat.tanggal.strftime("%d-%m-%Y") %></td><td><%= riwayat.kendaraan_dinas.nomor_polisi %></td><td><%= riwayat.jenis %></td><td><%= number_to_currency riwayat.biaya || 0, unit: "Rp", precision: 0, delimiter: "." %></td><td class="actions"><%= link_to "Detail", riwayat, class: "link" %><%= link_to "Ubah", edit_riwayat_perawatan_path(riwayat), class: "link" %><%= button_to "Hapus", riwayat, method: :delete, class: "button button--danger", form: { data: { turbo_confirm: "Hapus riwayat perawatan ini?" } } %></td></tr><% end %><% if @riwayat_perawatans.empty? %><tr><td colspan="5" class="empty">Tidak ada riwayat perawatan yang cocok.</td></tr><% end %></tbody></table><%= render "shared/pagination", pagination: @pagination %></section>
