<section class="page-heading"><div><h1>Riwayat Perawatan</h1><p>Catatan pemeriksaan dan perbaikan kendaraan operasional.</p></div><%= link_to "+ Catat perawatan", new_riwayat_perawatan_path, class: "button" %></section>
<section class="panel"><div class="panel-header"><h2>Riwayat terbaru</h2><input class="search" data-table-search="#maintenances" placeholder="Cari kendaraan atau jenis perawatan"></div><table id="maintenances"><thead><tr><th>Tanggal</th><th>Kendaraan</th><th>Jenis</th><th>Biaya</th><th></th></tr></thead><tbody><% @riwayat_perawatans.each do |riwayat| %><tr><td><%= l riwayat.tanggal, format: :long %></td><td><%= riwayat.kendaraan_dinas.nomor_polisi %></td><td><%= riwayat.jenis %></td><td><%= number_to_currency riwayat.biaya || 0, unit: "Rp", precision: 0, delimiter: "." %></td><td class="actions"><%= link_to "Detail", riwayat, class: "link" %><%= link_to "Ubah", edit_riwayat_perawatan_path(riwayat), class: "link" %><%= button_to "Hapus", riwayat, method: :delete, class: "button button--danger", form: { data: { turbo_confirm: "Hapus riwayat perawatan ini?" } } %></td></tr><% end %><% if @riwayat_perawatans.empty? %><tr><td colspan="5" class="empty">Belum ada riwayat perawatan.</td></tr><% end %></tbody></table></section>
