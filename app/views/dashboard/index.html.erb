<% content_for :title, "Dasbor KDO" %>
<section class="page-heading"><div><h1>Dasbor</h1><p>Ringkasan data Kendaraan Dinas Operasional.</p></div><%= link_to "+ Tambah kendaraan", new_kendaraan_dinas_path, class: "button" %></section>
<section class="cards"><div class="card"><p>Total kendaraan</p><strong><%= @total_kendaraan %></strong></div><div class="card"><p>Pegawai terdaftar</p><strong><%= @total_pegawai %></strong></div><div class="card"><p>Perangkat daerah</p><strong><%= @total_perangkat_daerah %></strong></div></section>
<section class="status-summary"><div><span>Baik</span><strong><%= @status_counts.fetch("baik", 0) %></strong></div><div><span>Rusak Ringan</span><strong><%= @status_counts.fetch("rusak_ringan", 0) %></strong></div><div><span>Rusak Berat</span><strong><%= @status_counts.fetch("rusak_berat", 0) %></strong></div></section>
<section class="panel"><div class="panel-header"><h2>Kendaraan terbaru</h2><%= link_to "Lihat semua", kendaraan_dinas_index_path, class: "link" %></div><table><thead><tr><th>Nomor polisi</th><th>Kendaraan</th><th>Penanggung jawab</th><th>Status</th></tr></thead><tbody><% @kendaraan_terbaru.each do |kendaraan| %><tr><td><%= link_to kendaraan.nomor_polisi, show_kendaraan_path(kendaraan), class: "link" %></td><td><%= kendaraan.merek %> <%= kendaraan.model %></td><td><%= kendaraan.penanggung_jawab.nama %></td><td><span class="badge badge--<%= kendaraan.status %>"><%= kendaraan.status.titleize %></span></td></tr><% end %><% if @kendaraan_terbaru.empty? %><tr><td colspan="4" class="empty">Belum ada kendaraan. Tambahkan data kendaraan pertama Anda.</td></tr><% end %></tbody></table></section>
<section class="panel" style="margin-top: 24px"><div class="panel-header"><h2>Perawatan terbaru</h2><%= link_to "Lihat semua", riwayat_perawatans_path, class: "link" %></div><table><thead><tr><th>Tanggal</th><th>Kendaraan</th><th>Jenis</th><th>Biaya</th></tr></thead><tbody><% @riwayat_terbaru.each do |riwayat| %><tr><td><%= riwayat.tanggal.strftime("%d-%m-%Y") %></td><td><%= riwayat.kendaraan_dinas.nomor_polisi %></td><td><%= riwayat.jenis %></td><td><%= number_to_currency riwayat.biaya || 0, unit: "Rp", precision: 0, delimiter: "." %></td></tr><% end %><% if @riwayat_terbaru.empty? %><tr><td colspan="4" class="empty">Belum ada riwayat perawatan.</td></tr><% end %></tbody></table></section>
